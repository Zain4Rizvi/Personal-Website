    addi $t0, $t0, 256
    sw $t1, 0($t0)
    sw $t1, 4($t0)
    sw $t1, 8($t0)

    jr $ra

	
SCORE_1:	# Draw 1 dot
	li $t0, BASE_ADDRESS
	li $t1, GREEN
	
	add $t0, $t0, 1540
	sw $t1, 0($t0)
	
	lw $ra, 0($sp)		# Load From Stack
	addi $sp, $sp, 4
	
	jr $ra
SCORE_2:	# Draw 2 dot
	li $t0, BASE_ADDRESS
	li $t1, GREEN
	
	add $t0, $t0, 1540
	sw $t1, 0($t0)
	sw $t1, 20($t0)
	
	lw $ra, 0($sp)		# Load From Stack
	addi $sp, $sp, 4
	
	jr $ra
SCORE_3: 	# Draw 3 dot
	li $t0, BASE_ADDRESS
	li $t1, GREEN
	
	add $t0, $t0, 1540
	sw $t1, 0($t0)
	sw $t1, 20($t0)
	sw $t1, 40($t0)
	
	lw $ra, 0($sp)		# Load From Stack
	addi $sp, $sp, 4
	
	jr $ra
	

ERASE: # Clear the screen
	li $t0, BASE_ADDRESS
	li $t1, SCREEN_WIDTH
	li $t2, SCREEN_HEIGHT
	li $t3, BLACK
	mul $t1, $t1, $t2	# Height * Width	
	mul $t1, $t1, 4		# Height * Width * 4 (represent each pixel
	add $t1, $t0, $t1	# End of Screen Pixel at $t1
	j ERASE_LOOP

	ERASE_LOOP:		# While current < final pixel: clear pixel and move to next
		bgt $t0, $t1, ERASED
		sw $t3, 0($t0)
		addi $t0, $t0, 4	#Push Background Color on stack at $t0
		j ERASE_LOOP
	ERASED:
		jr $ra #Done Erasing return to main
		

FAIL:
	#Clear Screen
	jal ERASE
	# Draw YOU FAIL
	li $t0, BASE_ADDRESS
	li $t1, RED
	li $t2, 7012	# Change this acoordingly
	add $t2, $t2, $t0
	
	#  F
	sw $t1, 0($t2)
	sw $t1, 4($t2)
	sw $t1, 8($t2)
	addi $t2, $t2, 256
	sw $t1, 0($t2)
	addi $t2, $t2, 256
	sw $t1, 0($t2)
	sw $t1, 4($t2)
	addi $t2, $t2, 256
	sw $t1, 0($t2)
	addi $t2, $t2, 256
	sw $t1, 0($t2)
	
	# A
	li $t2, 7028	# Change this acoordingly
	add $t2, $t2, $t0
	
	sw $t1, 0($t2)
	sw $t1, 4($t2)
	sw $t1, 8($t2)
	addi $t2, $t2, 256
	sw $t1, 0($t2)
	sw $t1, 8($t2)
