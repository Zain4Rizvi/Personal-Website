    sw $t1, 4($t0)
    addi $t0, $t0, 256
    sw $t1, 0($t0)
    sw $t1, 8($t0)

    ############ E ############
    li $t0, BASE_ADDRESS
    addi $t0, $t0, 64
    sw $t1, 0($t0)
    sw $t1, 4($t0)
    sw $t1, 8($t0)
    addi $t0, $t0, 256
