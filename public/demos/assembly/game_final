	sw $t1, 8($t2)
	addi $t2, $t2, 256
	sw $t1, 0($t2)
	sw $t1, 8($t2)
	addi $t2, $t2, 256
	
	# I
	li $t2, 7044	# Change this acoordingly
	add $t2, $t2, $t0
	
	sw $t1, 0($t2)
	sw $t1, 4($t2)
	sw $t1, 8($t2)
	addi $t2, $t2, 256
	sw $t1, 4($t2)
	addi $t2, $t2, 256
	sw $t1, 4($t2)
	addi $t2, $t2, 256
	sw $t1, 4($t2)
	addi $t2, $t2, 256
	sw $t1, 0($t2)
	sw $t1, 4($t2)
	sw $t1, 8($t2)
	
	# L
	li $t2, 7056	# Change this acoordingly
	add $t2, $t2, $t0
	
	sw $t1, 4($t2)
	addi $t2, $t2, 256
	sw $t1, 4($t2)
	addi $t2, $t2, 256
	sw $t1, 4($t2)
	addi $t2, $t2, 256
	sw $t1, 4($t2)
	addi $t2, $t2, 256
	sw $t1, 4($t2)
	sw $t1, 8($t2)
	sw $t1, 12($t2)
	
	j END_LOOP
	
WIN:
	# Clear Screen
	jal ERASE

	# Draw WIN
	li $t0, BASE_ADDRESS
	li $t1, GREEN              # You can choose any color
	li $t2, 0               # Adjust starting position
	li $t3, 7012
	add $t2, $t3, $t0
	
	# W
	sw $t1, 0($t2)             # Row 0
	sw $t1, 8($t2)
	sw $t1, 16($t2)
	addi $t2, $t2, 256
	sw $t1, 0($t2)             # Row 1
	sw $t1, 8($t2)
	sw $t1, 16($t2)
	addi $t2, $t2, 256
	sw $t1, 0($t2)             # Row 2
	sw $t1, 8($t2)
	sw $t1, 16($t2)
	addi $t2, $t2, 256
	sw $t1, 0($t2)             # Row 3
	sw $t1, 8($t2)
	sw $t1, 16($t2)
	addi $t2, $t2, 256
	sw $t1, 4($t2)             # Row 4
	sw $t1, 12($t2)

	# I (reposition to next letter)

	addi $t3, $t3, 20
	add $t2, $t3, $t0
	
	sw $t1, 4($t2)             # Row 0
	addi $t2, $t2, 256
	sw $t1, 4($t2)             # Row 1
	addi $t2, $t2, 256
	sw $t1, 4($t2)             # Row 2
	addi $t2, $t2, 256
	sw $t1, 4($t2)             # Row 3
	addi $t2, $t2, 256
	sw $t1, 4($t2)             # Row 4

	# N (reposition to next letter)

	addi $t3, $t3, 12
	add $t2, $t3, $t0
	
	sw $t1, 0($t2)             # Row 0
	sw $t1, 12($t2)
	addi $t2, $t2, 256
	sw $t1, 0($t2)             # Row 1
	sw $t1, 4($t2)
	sw $t1, 12($t2)
	addi $t2, $t2, 256
	sw $t1, 0($t2)             # Row 2
	sw $t1, 8($t2)
	sw $t1, 12($t2)
	addi $t2, $t2, 256
	sw $t1, 0($t2)             # Row 3
	sw $t1, 12($t2)
	sw $t1, 12($t2)
	addi $t2, $t2, 256
	sw $t1, 0($t2)             # Row 4
	sw $t1, 12($t2)

	j END_LOOP
	
	
END_LOOP:
	# See if Press Happened
	jal DRAW_SCORE
	li $t9, 0xffff0000 
	lw $t8, 0($t9) 
	bne $t8, 1, END_SLEEP	# If no Press we can just skip
	lw $t2, 4($t9) # this assumes $t9 is set to 0xfff0000 from before 
	
	#Check Which Press and Brnach
	beq $t2, R_KEY, R_PRESSED 
	beq $t2, Q_KEY, Q_PRESSED 

END_SLEEP:
	li $v0, 32 
	li $a0, SLEEP # Wait one second (1000 milliseconds)
	syscall
	J END_LOOP
