# Cloudflare Web Analytics site token. Leave empty to disable (no beacon is rendered).
# Build-time: pass via docker compose build or the shell environment.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Server-only. Used by /api/donations/by-party, /api/records, and /api/export.
# Leave unset to serve the checked-in province totals preview. Never expose these to the client.
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
